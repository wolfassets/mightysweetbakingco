{
  "name": "@mightysweet/api",
  "version": "1.0.0",
  "description": "Mighty Sweet Cookies — dedicated Hono API service",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.13.0",
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.4.1",
    "@hono/zod-openapi": "^0.18.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.5.1",
    "hono": "^4.6.12",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@clerk/shared",
      "@lng2004/node-datachannel",
      "@seydx/node-av-darwin-arm64",
      "core-js",
      "esbuild",
      "node-av",
      "node-datachannel",
      "sharp",
      "zeromq"
    ]
  }
}
