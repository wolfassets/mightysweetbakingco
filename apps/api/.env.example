# Mighty Sweet Cookies — Hono API runtime config.
# Copy to .env and fill in the real values. .env is git-ignored.

# ──────────────────────────────────────────────────────────────────────────
# Database (Turso)
# ──────────────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Redis (rate-limit, idempotency, SSE pub/sub)
# Local dev:       redis://127.0.0.1:6379
# docker-compose:  redis://redis:6379  (set automatically in compose env)
# ──────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ──────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS.
# Add the prod web URL once Vercel deploys.
CORS_ORIGINS=https://mightysweetbakingco.com,https://mightysweetbakingco-web.vercel.app,http://localhost:4002
